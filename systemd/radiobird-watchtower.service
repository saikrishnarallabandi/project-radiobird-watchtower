[Unit]
Description=RadioBird Supply Chain Watchtower hourly checkpoint

[Service]
Type=oneshot
WorkingDirectory=/path/to/project_radiobird_watchtower
Environment=PYTHONUNBUFFERED=1
Environment=WATCHTOWER_PRIVACY_GUARD=/path/to/privacy_guard.py
ExecStart=/usr/bin/python3 /path/to/project_radiobird_watchtower/scripts/hourly_issue_update.py

